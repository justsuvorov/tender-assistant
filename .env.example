# Провайдер LLM: gemini | anthropic | ollama | qwen | vsk
AI_PROVIDER=gemini
AI_TEMPERATURE=0.2

# Gemini
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-sonnet-5

# Ollama (локально или на GPU-сервере)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:14b
# Контекстное окно модели: по нему обрезается база знаний в промпте.
# 0 — не ограничивать.
LLM_NUM_CTX=32768

# Qwen (OpenAI-совместимый /v1/completions)
QWEN_API_URL=http://localhost:8000/v1/completions
QWEN_MODEL_NAME=qwen
QWEN_MAX_TOKENS=8192

# VSK AI (OpenAI-совместимый /v1/chat/completions)
VSK_API_URL=http://localhost:8000/v1/chat/completions
VSK_API_KEY=
VSK_MODEL_NAME=vsk
VSK_MAX_TOKENS=100000
VSK_THINKING_TOKEN_BUDGET=1000

# Куда складываются отчёты, если results_path не задан в запросе
RESULTS_ROOT=results

# Ограничение окна при сборке промпта (0 = по провайдеру:
# self-hosted берут LLM_NUM_CTX, облачные не режут промпт)
PROMPT_CONTEXT_WINDOW=0
