# Провайдер LLM: gemini | anthropic | ollama | qwen | vsk
AI_PROVIDER=gemini
AI_TEMPERATURE=0.2

# Gemini
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-sonnet-5

# Ollama (локально или на GPU-сервере)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:14b
# Контекстное окно модели: по нему обрезается база знаний в промпте.
# 0 — не ограничивать.
LLM_NUM_CTX=32768

# Qwen (OpenAI-совместимый /v1/completions)
QWEN_API_URL=http://localhost:8000/v1/completions
QWEN_MODEL_NAME=qwen
QWEN_MAX_TOKENS=8192

# VSK AI (OpenAI-совместимый /v1/chat/completions)
VSK_API_URL=http://localhost:8000/v1/chat/completions
VSK_API_KEY=
VSK_MODEL_NAME=vsk
VSK_MAX_TOKENS=100000
VSK_THINKING_TOKEN_BUDGET=1000

# Куда складываются отчёты, если results_path не задан в запросе
RESULTS_ROOT=results

# Ограничение окна при сборке промпта (0 = по провайдеру:
# self-hosted берут LLM_NUM_CTX, облачные не режут промпт)
PROMPT_CONTEXT_WINDOW=0

# ── ЖУРНАЛ ───────────────────────────────────────────────────────────────────────
# INFO — этапы, каждый вызов модели (размер, время), ошибки с трассировкой.
# DEBUG — плюс начало каждого промпта и ответа модели: для разбора ошибок,
# в журнал при этом попадают данные из документов.
LOG_LEVEL=INFO
# Папка журнала (tender_assistant.log, ротация 10 файлов по 10 МБ).
# Относительный путь — от папки с EXE.
LOG_DIR=logs

# ── ПРОМПТЫ ───────────────────────────────────────────────────────────────────
# Одной строкой, переносы — \n. Плейсхолдеры в {фигурных скобках} обязательны;
# литеральные скобки в примерах JSON удваиваются: {{ }}.
# Пустое значение или удалённая строка — используется промпт из core/config.py.

# Общая роль — подставляется в промпты вместо {role}
AI_ROLE=Ты — специалист тендерного отдела. Ты работаешь с конкурсной документацией: разбираешь требования заказчика, определяешь перечень необходимых документов и заполняешь формы заявок. Ты отвечаешь строго по существу и никогда не придумываешь данные, которых нет в исходных материалах.

# Этап 1. Выбор раздела со списком документов. {structured_text} — заголовки
DOCUMENT_LIST_HEADER_SEARCHER_TEMPLATE={role}\n\n### ЗАДАЧА\nНиже приведён перечень заголовков разделов документа с требованиями к подаче\nзаявки на конкурс (тендер). Под каждым заголовком после «—» дано начало текста\nраздела. Определи разделы, где перечислены ДОКУМЕНТЫ, которые участник обязан\nприложить к заявке. Решай по началу текста, а не только по заголовку: раздел с\nполным перечнем может называться иначе, а раздел «Состав заявки» — содержать\nлишь ссылку на другой раздел.\n\nРаздел может называться по-разному, например: «Перечень документов»,\n«Состав заявки», «Требования к содержанию заявки», «Документы, входящие в состав\nзаявки», «Приложения к заявке», «Квалификационные требования». Опирайся\nна СМЫСЛ заголовка, а не на точное совпадение слов.\n\n### ЗАГОЛОВКИ\n{structured_text}\n\n### ФОРМАТ ОТВЕТА\nВерни ТОЛЬКО JSON без пояснений и без markdown-обрамления:\n{{"headers": ["<заголовок точно как в списке, без текста после «—»>"], "confidence": "high|medium|low"}}\n\nЕсли подходящих заголовков несколько — перечисли все.\nЕсли ни один заголовок не подходит — верни {{"headers": [], "confidence": "low"}}.\n

# Этап 1. Извлечение перечня из раздела. {section_text} — текст раздела
DOCUMENT_LIST_SEARCHER_TEMPLATE={role}\n\n### ЗАДАЧА\nНиже приведён текст раздела документа с требованиями к подаче заявки на конкурс\n(тендер). Сначала убедись, что в тексте действительно перечислены документы,\nкоторые нужно приложить к заявке. Затем выпиши перечень этих документов.\n\nПравила:\n1. Один пункт ответа — один документ.\n2. Название документа приводи в нормальной форме, без нумерации. Сохраняй\n   существенные уточнения (например, «за последний отчётный год»).\n3. Не включай пункты, которые не являются документами: сроки, порядок подачи,\n   способ упаковки конвертов, реквизиты заказчика.\n4. Ничего не придумывай — только то, что есть в тексте.\n\n### ТЕКСТ РАЗДЕЛА\n{section_text}\n\n### ФОРМАТ ОТВЕТА\nВерни ТОЛЬКО JSON без пояснений и без markdown-обрамления:\n{{"is_document_list": true,\n  "documents": [\n    {{"name": "<название документа>",\n      "mandatory": true,\n      "note": "<уточнение из текста или пустая строка>"}}\n  ]}}\n\nЕсли раздел НЕ содержит перечня документов — верни\n{{"is_document_list": false, "documents": []}}.\n

# Этап 1. Проверка по нормативной базе. {normative_base}, {documents}
DOCUMENT_LIST_NORMATIVE_FILTER_TEMPLATE={role}\n\n### ЗАДАЧА\nНиже приведён предварительный перечень документов, извлечённый из конкурсной\nдокументации, и нормативная база организации. Проверь перечень по нормативной\nбазе и оставь только те документы, которые действительно требуются от нашего\nюридического лица.\n\nИсключай документы, которые:\n- относятся к другой организационно-правовой форме (например, к ИП или физлицу);\n- требуются только при условиях, которые к нам не относятся;\n- дублируют друг друга — оставь одну формулировку.\n\n### НОРМАТИВНАЯ БАЗА\n{normative_base}\n\n### ПРЕДВАРИТЕЛЬНЫЙ ПЕРЕЧЕНЬ\n{documents}\n\n### ФОРМАТ ОТВЕТА\nВерни ТОЛЬКО JSON без пояснений и без markdown-обрамления:\n{{"documents": [\n    {{"name": "<итоговое название документа>",\n      "mandatory": true,\n      "note": "<обоснование включения или уточнение>"}}\n  ],\n  "excluded": [\n    {{"name": "<исключённый документ>", "note": "<причина исключения>"}}\n  ]}}\n\nЕсли нормативная база пуста — верни исходный перечень без изменений\nи пустой список excluded.\n

# Этап 2. Подбор файла под документ. {target_name}, {name_list}
DOCUMENT_NAME_MATCHER={role}\n\n### ЗАДАЧА\nНиже приведено название документа, который нужно приложить к тендерной заявке,\nи перечень файлов из архива организации. Найди файл или файлы, которые по смыслу\nсоответствуют требуемому документу.\n\nПравила:\n1. Сопоставляй по СМЫСЛУ, а не по точному совпадению строк: имена файлов бывают\n   сокращёнными, с датами, номерами и транслитерацией.\n2. Если подходящих файлов несколько (например, за разные годы) — верни все,\n   первым самый подходящий.\n3. Если уверенного соответствия нет, но есть похожий кандидат — верни его\n   со значением confidence "medium" или "low".\n4. Не придумывай имена файлов: возвращай строки ТОЧНО как в перечне.\n\n### ТРЕБУЕМЫЙ ДОКУМЕНТ\n{target_name}\n\n### ФАЙЛЫ В АРХИВЕ\n{name_list}\n\n### ФОРМАТ ОТВЕТА\nВерни ТОЛЬКО JSON без пояснений и без markdown-обрамления:\n{{"files": ["<имя файла точно как в перечне>"],\n  "confidence": "high|medium|low",\n  "note": "<короткий комментарий>"}}\n\nЕсли ничего не подходит — верни {{"files": [], "confidence": "low", "note": "..."}}.\n

# Этап 3. Поля шаблона заявки. {template_text} — шаблон в markdown
TENDER_FORM_FIELDS_TEMPLATE={role}\n\n### ЗАДАЧА\nНиже приведён шаблон тендерной заявки в формате markdown. Определи все поля,\nкоторые должен заполнить участник: пустые ячейки таблиц, места с прочерками,\nподчёркиваниями, угловыми скобками, а также пункты вида «указать ...».\n\nДля каждого поля верни его наименование ровно так, как оно записано в шаблоне —\nпо этой строке поле будет найдено в исходном файле.\n\n### ШАБЛОН\n{template_text}\n\n### ФОРМАТ ОТВЕТА\nВерни ТОЛЬКО JSON без пояснений и без markdown-обрамления:\n{{"fields": [\n    {{"label": "<наименование поля из шаблона>",\n      "anchor": "<строка или ячейка шаблона, куда вписывается значение>",\n      "kind": "table_row|line"}}\n  ]}}\n

# Этап 3. Материалы для заполнения (кэшируемая часть). {context}
TENDER_FORM_FILL_CONTEXT_TEMPLATE={role}\n\n### ЗАДАЧА\nШаблон тендерной заявки запрашивает значения полей. Для каждого поля ищи\nзначение в приведённых ниже материалах: эталонных заявках, базе знаний\nорганизации и требованиях тендера.\n\nПравила:\n1. Ничего не придумывай. Если значения нет в материалах — статус "missing".\n2. Если значение найдено дословно и однозначно — статус "found".\n3. Если значение выведено косвенно, устарело, встречается в нескольких вариантах\n   или относится к другому тендеру — статус "check".\n4. Значение должно быть готово к вставке в документ: без пояснений,\n   без обрамляющих кавычек, без префикса вида «Ответ:».\n\n### МАТЕРИАЛЫ\n{context}\n

# Этап 3. Запрос значения одного поля. {field_label}
TENDER_FORM_FILL_FIELD_TEMPLATE=### ЗАПРАШИВАЕМОЕ ПОЛЕ\n{field_label}\n\n### ФОРМАТ ОТВЕТА\nВерни ТОЛЬКО JSON без пояснений и без markdown-обрамления:\n{{"value": "<значение для вставки>",\n  "status": "found|check|missing",\n  "source": "<откуда взято: файл или раздел>",\n  "note": "<комментарий, если статус check или missing>"}}\n

# Этап 3. Пакетный запрос по пропускам ___ в тексте. {blanks_context}
TENDER_FORM_INLINE_BLANKS_TEMPLATE=### ПРОПУСКИ ДЛЯ ЗАПОЛНЕНИЯ\nНиже — фрагменты шаблона заявки. Внутри текста вместо пропусков стоят метки\nвида [[N]] — именно туда подставится твой ответ. Рядом в скобках может быть\nподсказка, что там должно быть указано; если подсказки нет — ориентируйся\nна смысл предложения целиком.\n\n{blanks_context}\n\nДля КАЖДОЙ метки [[N]] найди значение в материалах выше.\n\n### ФОРМАТ ОТВЕТА\nВерни ТОЛЬКО JSON без пояснений и без markdown-обрамления — объект, где\nключ — номер метки строкой, значение — как в примере:\n{{"1": {{"value": "<значение>", "status": "found|check|missing",\n         "source": "<откуда взято>", "note": "<комментарий>"}},\n  "2": {{"value": "...", "status": "...", "source": "...", "note": "..."}}}}\n\nВерни запись по КАЖДОЙ метке, перечисленной выше, даже если значение не\nнайдено (тогда status "missing", value "").\n
